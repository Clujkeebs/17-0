    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/nextjs": "^11.1.0",
    "@sentry/node": "^11.1.0",
    "bad-words": "^4.1.5",
    "bcryptjs": "^3.0.3",
